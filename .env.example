SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-python-backend-only
DATABASE_URL=postgresql://postgres:your-password@your-host:5432/postgres

PYTHON_BACKEND_HOST=127.0.0.1
PYTHON_BACKEND_PORT=8000
FLUTTER_API_BASE_URL=http://127.0.0.1:8000

# Optional browser-accessible thermal camera bridge endpoint.
# Flutter sends POST JSON: {"patient_id":"...","patient_name":"..."}
# Expected response: {"temperature_c":37.1,"face_recognition_confirmed":true}
THERMAL_CAMERA_API_URL=

# Shared identifier used by the DigitalOcean API and Raspberry Pi command agent.
MOASHIR_THERMAL_CAMERA_DEVICE_ID=hospital-main
